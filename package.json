{
  "name": "playzinordia",
  "version": "3.4.5",
  "private": true,
  "description": "Teste Z / PlayZinordia — jogo de tabuleiro hexagonal no navegador.",
  "type": "module",
  "scripts": {
    "dev": "node ferramentas/servidor.mjs",
    "dev:rede": "node ferramentas/servidor.mjs --rede",
